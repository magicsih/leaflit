{
  "version": "0.1.0",
  "approval": "2026-10-18 owner-supplied implementation plan; 2026-10-19 owner-approved English assets, follow-up issues and sequential public release",
  "level": "L3",
  "environments": [
    "macOS development app",
    "macOS Release app"
  ],
  "redesign": true,
