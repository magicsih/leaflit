  "policyScope": "Personal magicsih repository; Seorilabs central validator does not apply.",
  "minimumOS": "14.0",
  "unverifiedOS": [
    "macOS 14",
    "macOS 15"
  ],
  "releaseVerification": {
    "independentDevelopmentChecks": true,
    "signedArtifactLaunch": true,
    "developerID": true,
    "notarization": true,
    "stapling": true,
    "gatekeeper": true,
    "publicArchiveReadback": true,
    "homebrewInstall": true,
