    "channels": [
      "GitHub Release",
      "Homebrew tap"
    ],
    "repository": "magicsih/leaflit",
    "tap": "magicsih/homebrew-tap"
  },
  "coverage": [
    "open routes and duplicate windows",
    "Markdown and Unicode",
    "search and copy",
    "relative navigation and anchors",
    "live reload and scroll",
    "recovery",
    "offline diagrams and math",
    "hostile content",
    "small window and zoom",
    "system appearance",
    "keyboard and VoiceOver",
    "100KiB 20 cold opens and 20 transitions",
